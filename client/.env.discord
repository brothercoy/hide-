# The Discord Activity build (`npm run build:discord` -> vite --mode discord -> dist-discord/).
#
# Deliberately NO VITE_SERVER_URL. Discord serves the game from its own domain and proxies '/'
# back to hide-ascii.com, so the relative default in game.js is already correct: /time and
# /join/CODE reach the real server, and the socket goes to the page's own host. Setting a server
# url here would point the game at a domain Discord's sandbox refuses to connect to.
#
# Your Discord application's Client ID, from the Developer Portal's OAuth2 tab. It is a public
# value; the secret is the other field there and never belongs in a client build.
VITE_DISCORD_CLIENT_ID=1552058124716875827
VITE_DISCORD=1
# Discord supplies the frame and its own fullscreen control, so the game drops its fullscreen
# button and fits itself to whatever panel size Discord gives it \u2014 same as the itch build.
VITE_EMBEDDED=1
# The daily share card links back to the real site, not to Discord's proxy domain.
VITE_SHARE_URL=https://hide-ascii.com
