# The itch.io build (`npm run build:itch` → vite --mode itch). The page is served from itch's own
# domain, so the client must be told where the game actually lives: the server for the game
# socket, the room-code lookup and the lives clock, and the address the shared daily card links to.
# Nothing secret here — these are public addresses, and the file is committed on purpose.
VITE_SERVER_URL=https://hide-ascii.com
VITE_SHARE_URL=https://hide-ascii.com
# The host supplies its own fullscreen control and its own frame, so the game drops its fullscreen
# button (which cannot escape that frame anyway) and gives the settings gear the space instead.
VITE_EMBEDDED=1
